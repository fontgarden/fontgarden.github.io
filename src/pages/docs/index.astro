---
import { getCollection } from 'astro:content';
import DocsLayout from '../../layouts/DocsLayout.astro';
import { SECTIONS, inGuideSequence } from '../../lib/docs';

const docs = inGuideSequence(await getCollection('docs'));
const bySection = Object.keys(SECTIONS).map((key) => ({
  key,
  ...SECTIONS[key],
  pages: docs.filter((d) => d.data.section === key),
}));
---

<DocsLayout
  title="Guide"
  description="The guide to the Font.Garden system: source repositories, the grid, glyph grades, builds, checks, the font index, training data and models."
>
  <article class="doc docs-index">
    <h1>Guide</h1>

    <div class="chapter-introduction">
      <p>
        This guide is the specification of the Font.Garden system. It
        describes the source files of a font, the design rules, the build
        and the checks, the training data and the models. It also gives
        the procedure for a contribution.
      </p>
      <p>
        Each chapter has one subject. The chapters are in a sequence, but
        a reader can start at the chapter for the current task. The guide
        changes when the system changes.
      </p>
    </div>

    {bySection.map((section) => (
      <section>
        <h2>{section.title}</h2>
        <p class="section-description">{section.description}</p>
        <ul>
          {section.pages.map((page) => (
            <li>
              <a href={`/docs/${page.id}/`}>{page.data.title}</a>
              {page.data.summary && <span>{page.data.summary}</span>}
            </li>
          ))}
        </ul>
      </section>
    ))}
  </article>
</DocsLayout>
