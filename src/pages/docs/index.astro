---
import { getCollection } from 'astro:content';
import DocsLayout from '../../layouts/DocsLayout.astro';
import { LABELS, SECTIONS } from '../../lib/docs';

const docs = (await getCollection('docs')).sort((a, b) => a.data.order - b.data.order);
const bySection = Object.keys(SECTIONS).map((key) => ({
  key,
  ...SECTIONS[key],
  pages: docs.filter((d) => d.data.section === key),
}));
---

<DocsLayout
  title="Guide"
  description="Documentation for the Font Garden system: source repositories, the power-of-two grid, glyph grades, builds, checks, the font index, training data and models."
>
  <article class="doc docs-index">
    <h1>Documentation</h1>

    <div class="callout">
      <p>
        Font Garden is one open font collection, not a catalog of families
        by named designers. Every glyph in it is drawn on one grid system,
        graded by a person, and used as training data for the open-weight
        models that draft the next glyphs. This guide describes the files,
        the engineering rules, the build and test tools, the data pipeline
        and the way contributions enter the collection. It is a draft,
        started 2026-11-04, and will change as the system does.
      </p>
      <p>
        The guide is split into short chapters. Read the chapters you need
        for the stage you are at. Each chapter carries one of these labels:
      </p>
      <ul class="legend">
        {Object.values(LABELS).map((l) => (
          <li><mark class={l.color}>{l.text}</mark>{l.meaning}</li>
        ))}
      </ul>
      <p>
        The structure of this guide is adapted from the
        <a href="https://googlefonts.github.io/gf-guide/">Google Fonts Guide</a>,
        published under the Apache License 2.0.
      </p>
    </div>

    {bySection.map((section) => (
      <section>
        <h2>{section.title}</h2>
        <p class="section-description">{section.description}</p>
        <ul>
          {section.pages.map((page) => {
            const label = LABELS[page.data.label];
            return (
              <li>
                <mark class={label.color}>{label.text}</mark>
                <a href={`/docs/${page.id}/`}>{page.data.title}</a>
              </li>
            );
          })}
        </ul>
      </section>
    ))}
  </article>
</DocsLayout>
