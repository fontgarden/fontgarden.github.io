---
import { getCollection, getEntry, render } from 'astro:content';
import DocsLayout from '../../layouts/DocsLayout.astro';
import { LABELS, REPOSITORY, inGuideSequence, lastChanged } from '../../lib/docs';

export async function getStaticPaths() {
  const docs = inGuideSequence(await getCollection('docs'));
  return docs.map((doc, i) => ({
    params: { slug: doc.id },
    props: { doc, previousChapter: docs[i - 1] ?? null, nextChapter: docs[i + 1] ?? null },
  }));
}

const { doc, previousChapter, nextChapter } = Astro.props;
const { Content, headings } = await render(doc);
const toc = headings.filter((h) => h.depth === 2);
const label = LABELS[doc.data.label];
const file = `src/content/docs/${doc.id}.md`;
const changed = lastChanged(file);

const resolve = async (ids: string[]) =>
  (await Promise.all(ids.map((id) => getEntry('docs', id)))).filter(Boolean);
const background = await resolve(doc.data.background);
const next = await resolve(doc.data.next);
---

<DocsLayout title={doc.data.title} description={doc.data.summary}>
  <article class="doc">
    <a href="/docs/" class="index-link">&larr; Guide index</a>

    <h1><mark class={label.color}>{label.text}</mark>{doc.data.title}</h1>

    {doc.data.callout && (
      <div class="callout">
        <p set:html={doc.data.callout} />
      </div>
    )}

    {background.length > 0 && (
      <div class="context-reading">
        Background reading:<br />
        {background.map((b) => {
          const l = LABELS[b.data.label];
          return (
            <>
              <mark class={l.color}>{l.text}</mark>
              <a href={`/docs/${b.id}/`}>{b.data.title}</a>
              <br />
            </>
          );
        })}
      </div>
    )}

    {toc.length > 1 && (
      <nav aria-label="Table of contents">
        <ol class="toc">
          {toc.map((h) => (
            <li><a href={`#${h.slug}`}>{h.text}</a></li>
          ))}
        </ol>
      </nav>
    )}

    <Content />

    {next.length > 0 && (
      <div class="next-reading">
        Next reading:<br />
        {next.map((n) => {
          const l = LABELS[n.data.label];
          return (
            <>
              <mark class={l.color}>{l.text}</mark>
              <a href={`/docs/${n.id}/`}>{n.data.title}</a>
              <br />
            </>
          );
        })}
      </div>
    )}

    <p class="chapter-source">
      {changed && <span>Last change: <time datetime={changed}>{changed}</time>.</span>}
      <a href={`${REPOSITORY}/edit/main/${file}`}>Edit this chapter on GitHub</a>
    </p>

    <nav class="chapter-links" aria-label="Chapters">
      {previousChapter ? (
        <a href={`/docs/${previousChapter.id}/`}>
          <span>Previous chapter</span>
          {previousChapter.data.title}
        </a>
      ) : (
        <span />
      )}
      {nextChapter ? (
        <a href={`/docs/${nextChapter.id}/`}>
          <span>Next chapter</span>
          {nextChapter.data.title}
        </a>
      ) : (
        <span />
      )}
    </nav>
  </article>
</DocsLayout>
