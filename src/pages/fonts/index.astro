---
import Layout from '../../layouts/Layout.astro';
import FontFaces from '../../components/FontFaces.astro';
import FontIndexList from '../../components/FontIndexList.astro';
import FontIndexPanel from '../../components/FontIndexPanel.astro';
import { INDEX_SIZE, loadFonts } from '../../lib/fonts';
import '../../styles/fonts.css';

const fonts = await loadFonts();
---

<Layout
  title="Fonts · Font.Garden"
  description="FTGD-100: the index of the one hundred free and open source fonts of Font.Garden."
>
  <FontFaces fonts={fonts} slot="head" />
  <FontIndexPanel />

  <main
    class="relative z-10 flex min-h-[100dvh] flex-col pl-[var(--margin)] pr-[calc(var(--field)+2*var(--margin))] pt-[calc(var(--margin)+var(--text-logo)*1.25)] pb-[var(--margin)]"
  >
    <section class="max-w-[72ch]">
      <h1 class="font-index-title">FTGD-100</h1>
      <p class="text-small text-ink">
        The index of the one hundred fonts of Font.Garden, from 00 to 99. Each
        font is free and open source, and each font has the same specimen
        page. {fonts.length} of the {INDEX_SIZE} numbers have a font.
      </p>
    </section>

    <FontIndexList fonts={fonts} />

    <footer class="mt-auto pt-6">
      <nav class="flex items-center gap-5 text-small text-ink">
        <a href="/fonts/" class="underline-offset-4 hover:underline">Fonts</a>
        <a href="/docs/" class="underline-offset-4 hover:underline">Documentation</a>
      </nav>
    </footer>
  </main>
</Layout>
