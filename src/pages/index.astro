---
import Layout from '../layouts/Layout.astro';

const contact = 'mailto:eli@elih.net?subject=Font%20Garden';
---

<Layout title="Font Garden — Fonts that are neural networks">
  <!-- Fixed gradient field panel, right side -->
  <div
    id="field-panel"
    class="field-panel pointer-events-none fixed top-[var(--margin)] right-[var(--margin)] z-20 h-[calc(100dvh-2*var(--margin))] w-[var(--field)] overflow-hidden rounded-[14px] select-none"
    aria-hidden="true"
  >
    <div class="field-grain absolute inset-0"></div>
  </div>

  <!-- Fade content out as it scrolls up behind the wordmark -->
  <div
    class="top-fade pointer-events-none fixed inset-x-0 top-0 z-[15] h-[calc(var(--margin)+var(--text-logo)*1.15)]"
    aria-hidden="true"
  >
  </div>

  <!-- Wordmark -->
  <header>
    <a
      href="/"
      id="wordmark"
      class="fixed top-[var(--margin)] left-[var(--margin)] z-30 text-[length:var(--text-logo)] leading-none tracking-tight whitespace-nowrap"
      >Font.Garden</a
    >
  </header>

  <main
    class="relative z-10 flex min-h-[100dvh] flex-col pl-[var(--margin)] pr-[calc(var(--field)+2*var(--margin))] pt-[calc(var(--margin)+var(--text-logo)*1.25)] pb-[var(--margin)]"
  >
    <!-- Hero -->
    <section class="max-w-[72ch]">
      <h1 class="text-small text-ink">
        We are developing NeuralType, a post-OpenType font format where each
        font contains a neural network.
      </h1>
    </section>

    <!-- Intro -->
    <section class="my-6 max-w-[72ch] md:my-8">
      <div class="flex flex-col gap-5 text-small text-ink">
        <p>
          Font.Garden is a US-based open-weight AI lab rethinking global
          script typography from the ground up for the 21st century. We
          created NeuralType, a post-OpenType font format where the font is a
          neural network. We train and progressively release open-weight
          vector graphics models, and charge for API access to our frontier
          models.
        </p>
      </div>
    </section>

    <footer class="mt-auto pt-6">
      <nav class="flex items-center gap-5 text-small text-ink">
        <a
          href="https://github.com/fontgarden"
          class="underline-offset-4 hover:underline">GitHub</a
        >
        <a
          href="https://elih.net"
          class="underline-offset-4 hover:underline">elih.net</a
        >
        <a href={contact} class="underline-offset-4 hover:underline"
          >eli@elih.net</a
        >
      </nav>
    </footer>
  </main>

  <script>
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

    // Size the wordmark so its right edge sits one margin away from the
    // gradient panel, matching its top and left margins. The fitted size
    // is written back to --text-logo so the fade zone and the content
    // offset follow it.
    const wordmark = document.getElementById('wordmark');
    const panelEl = document.getElementById('field-panel');
    const fitWordmark = () => {
      if (!wordmark || !panelEl) return;
      const margin = parseFloat(
        getComputedStyle(document.documentElement).getPropertyValue('--margin')
      );
      const target = panelEl.getBoundingClientRect().left - 2 * margin;
      if (target <= 0) return;
      wordmark.style.fontSize = '100px';
      const width = wordmark.getBoundingClientRect().width;
      const size = (100 * target) / width;
      wordmark.style.fontSize = `${size}px`;
      document.documentElement.style.setProperty('--text-logo', `${size}px`);
    };
    document.fonts.ready.then(fitWordmark);
    window.addEventListener('resize', fitWordmark);
    fitWordmark();

    // DVD-screensaver bounce: each character of "Font.Garden" drifts
    // around the gradient panel and bounces off its edges.
    const panel = document.getElementById('field-panel');
    if (panel && !reduced.matches && panel.clientWidth > 120) {
      const spawn = (el) => {
        panel.appendChild(el);
        const speed = 30 + Math.random() * 50;
        const angle = Math.random() * Math.PI * 2;
        return {
          el,
          x: Math.random() * (panel.clientWidth - 40),
          y: Math.random() * (panel.clientHeight - 60),
          vx: Math.cos(angle) * speed,
          vy: Math.sin(angle) * speed,
        };
      };
      const chars = 'FontGarden'.split('').map((ch) => {
        const el = document.createElement('span');
        el.className = 'dvd-char';
        el.textContent = ch;
        return spawn(el);
      });
      const rose = document.createElement('img');
      rose.src = '/graphics/rose-001.png';
      rose.alt = '';
      rose.className = 'dvd-img';
      chars.push(spawn(rose));
      let last = performance.now();
      const step = (now) => {
        const dt = Math.min((now - last) / 1000, 0.05);
        last = now;
        const w = panel.clientWidth;
        const h = panel.clientHeight;
        for (const c of chars) {
          const cw = c.el.offsetWidth;
          const chh = c.el.offsetHeight;
          c.r = Math.max(cw, chh) / 2;
          c.x += c.vx * dt;
          c.y += c.vy * dt;
          if (c.x <= 0) { c.x = 0; c.vx = Math.abs(c.vx); }
          if (c.x >= w - cw) { c.x = w - cw; c.vx = -Math.abs(c.vx); }
          if (c.y <= 0) { c.y = 0; c.vy = Math.abs(c.vy); }
          if (c.y >= h - chh) { c.y = h - chh; c.vy = -Math.abs(c.vy); }
        }
        // Elastic collisions between letters (equal mass, circle bodies).
        for (let a = 0; a < chars.length; a++) {
          for (let b = a + 1; b < chars.length; b++) {
            const A = chars[a];
            const B = chars[b];
            const ax = A.x + A.r;
            const ay = A.y + A.r;
            const bx = B.x + B.r;
            const by = B.y + B.r;
            const dx = bx - ax;
            const dy = by - ay;
            const dist = Math.hypot(dx, dy) || 1;
            const minDist = (A.r + B.r) * 0.8;
            if (dist < minDist) {
              const nx = dx / dist;
              const ny = dy / dist;
              // Push the pair apart so they do not stick together.
              const overlap = (minDist - dist) / 2;
              A.x -= nx * overlap;
              A.y -= ny * overlap;
              B.x += nx * overlap;
              B.y += ny * overlap;
              // Swap the velocity components along the collision normal
              // if the letters are moving toward each other.
              const va = A.vx * nx + A.vy * ny;
              const vb = B.vx * nx + B.vy * ny;
              if (va - vb > 0) {
                A.vx += (vb - va) * nx;
                A.vy += (vb - va) * ny;
                B.vx += (va - vb) * nx;
                B.vy += (va - vb) * ny;
              }
            }
          }
        }
        for (const c of chars) {
          c.el.style.transform = `translate(${c.x}px, ${c.y}px)`;
        }
        requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    }
  </script>
</Layout>
