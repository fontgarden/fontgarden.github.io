---
import Layout from '../layouts/Layout.astro';

const contact = 'mailto:eli@elih.net?subject=Font%20Garden';

const heroPhrases = [
  'For Arabic.',
  'For Nastaʿliq.',
  'For Latin.',
  'For the scripts and styles that OpenType never served.',
];
---

<Layout title="Font Garden — Fonts that are neural networks">
  <!-- Fixed gradient field panel, right side -->
  <div
    id="field-panel"
    class="field-panel pointer-events-none fixed top-[var(--margin)] right-[var(--margin)] z-20 h-[calc(100dvh-2*var(--margin))] w-[var(--field)] overflow-hidden rounded-[14px] select-none"
    aria-hidden="true"
  >
    <div class="field-grain absolute inset-0"></div>
  </div>

  <!-- Fade content out as it scrolls up behind the wordmark -->
  <div
    class="top-fade pointer-events-none fixed inset-x-0 top-0 z-[15] h-[calc(var(--margin)+var(--text-logo)*2)]"
    aria-hidden="true"
  >
  </div>

  <!-- Wordmark -->
  <header>
    <a
      href="/"
      class="fixed top-[var(--margin)] left-[var(--margin)] z-30 text-[length:var(--text-logo)] leading-none tracking-tight"
      >Font.Garden</a
    >
  </header>

  <main
    class="relative z-10 flex flex-col pl-[var(--margin)] pr-[calc(var(--field)+2*var(--margin))] pt-[calc(var(--margin)+var(--text-logo)*2.2)] pb-[var(--margin)]"
  >
    <!-- Hero -->
    <section>
      <h1 class="text-h1 text-balance leading-tight">
        We are building fonts that are neural networks.
      </h1>
      <div class="mt-6 grid text-small text-muted" id="hero-slot" aria-label={heroPhrases.join(' ')}>
        {heroPhrases.map((p, i) => (
          <span class={`slot-phrase${i === 0 ? ' is-shown' : ''}`} aria-hidden="true">{p}</span>
        ))}
      </div>
    </section>

    <!-- Problem -->
    <section class="my-10 max-w-[72ch] md:my-14">
      <div class="flex flex-col gap-5 text-small text-ink">
        <p>
          An OpenType font is a box of fixed shapes: one outline per glyph,
          reused everywhere, in cells that digital type inherited from metal
          sorts. Latin fits this system. Much of the written world does not.
        </p>
        <p>
          Naskh, and above all Nastaʿliq, is one continuous, context-dependent
          stroke. The OpenType workaround is thousands of glyphs and
          substitution rules, and the result has never matched the manuscripts
          it comes from.
        </p>
      </div>
    </section>

    <!-- Format -->
    <section class="my-10 max-w-[72ch] md:my-14">
      <p class="mb-4 text-small text-muted">The NeuralType format</p>
      <div class="flex flex-col gap-5 text-small text-ink">
        <p>
          Our answer is NeuralType, the <code>.ntf</code> font format. A
          <code>.ntf</code> file is a small neural network. The character, its
          joining form, and settings such as elongation go into the network.
          The letterform comes out and is traced into vector outlines at the
          moment you type it. The shapes are computed, not retrieved.
        </p>
        <p>
          Computed does not mean random. The same text at the same settings
          produces identical outlines on every machine. Learned axes such as
          weight and elongation are continuous numbers: variable fonts without
          masters. The file is a short header and the network weights. The
          weights are the font.
        </p>
        <p>
          The spec and the Rust rendering engine are open source under
          Apache-2.0 or MIT at
          <a
            href="https://github.com/eliheuer/post-opentype"
            class="underline-offset-4 hover:underline"
            >github.com/eliheuer/post-opentype</a
          >. Live demos, with real editable text set by neural fonts, are at
          <a
            href="https://elih.net/blog/neuraltype"
            class="underline-offset-4 hover:underline"
            >elih.net/blog/neuraltype</a
          >.
        </p>
      </div>
    </section>

    <!-- How we work -->
    <section class="my-10 max-w-[72ch] md:my-14">
      <p class="mb-4 text-small text-muted">How we work</p>
      <div class="flex flex-col gap-5 text-small text-ink">
        <p>
          These fonts are grown more than they are drawn. A teacher describes
          the letterforms, a small model learns them, and the trained model
          becomes the font. We tend our fonts after release: retrain them,
          extend them to new scripts, and refine them.
        </p>
        <p>
          Our work continues the international typographic style, extended to
          the scripts that modernism ignored, with a focus on the Perso-Arabic
          script. Every font is open. Every model ships with open weights. The
          training data and the specs are published.
        </p>
      </div>
    </section>

    <!-- Plan -->
    <section class="my-10 max-w-[72ch] md:my-14">
      <p class="mb-4 text-small text-muted">The plan</p>
      <ol class="my-4 flex flex-col gap-6 text-small text-ink">
        <li class="flex gap-4">
          <span class="w-4 shrink-0 tabular-nums text-muted">1</span>
          <span>
            <span>Define the format.</span>
            Publish the <code>.ntf</code> spec, the rendering engine, and live
            demos. This work is underway and open source.
          </span>
        </li>
        <li class="flex gap-4">
          <span class="w-4 shrink-0 tabular-nums text-muted">2</span>
          <span>
            <span>Release fonts and models.</span>
            A first catalog of <code>.ntf</code> fonts and open-weight models,
            free under open licenses. Coming soon.
          </span>
        </li>
        <li class="flex gap-4">
          <span class="w-4 shrink-0 tabular-nums text-muted">3</span>
          <span>
            <span>Build the platform.</span>
            Distribution for <code>.ntf</code> fonts, hosted APIs for our
            models, and tools to train and tend your own. This is the
            business.
          </span>
        </li>
      </ol>
    </section>

    <!-- Who -->
    <section class="my-10 max-w-[72ch] md:my-14">
      <p class="mb-4 text-small text-muted">Who</p>
      <p class="text-small text-ink">
        Font Garden is founded by
        <a href="https://elih.net" class="underline-offset-4 hover:underline"
          >Eli Heuer</a
        >, a type designer and font engineer. The research notes and demos
        behind the format are on
        <a href="https://elih.net" class="underline-offset-4 hover:underline"
          >elih.net</a
        >.
      </p>
    </section>

    <!-- Contact -->
    <section class="my-10 max-w-[72ch] md:my-14">
      <p class="mb-4 text-small text-muted">Stay in touch</p>
      <p class="text-small text-ink">
        We will announce the first fonts and models by email.
        <a href={contact} class="underline-offset-4 hover:underline"
          >Write to us</a
        >
        to get the announcement, or to talk about the format, the models, or
        the seed round.
      </p>
    </section>

    <footer class="mt-20 md:mt-28">
      <nav class="flex items-center gap-5 text-small text-ink">
        <a
          href="https://github.com/fontgarden"
          class="min-w-0 truncate underline-offset-4 hover:underline">GitHub</a
        >
        <span class="hidden h-px w-8 min-w-1.5 shrink-[999] bg-rule sm:block"></span>
        <a
          href="https://elih.net"
          class="hidden underline-offset-4 hover:underline sm:inline"
          >elih.net</a
        >
        <span class="h-px min-w-1.5 flex-1 bg-rule"></span>
        <a href={contact} class="underline-offset-4 hover:underline"
          >eli@elih.net</a
        >
      </nav>
    </footer>
  </main>

  <script>
    const slot = document.getElementById('hero-slot');
    const phrases = slot ? slot.querySelectorAll('.slot-phrase') : [];
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    if (phrases.length > 1 && !reduced.matches) {
      let i = 0;
      setInterval(() => {
        phrases[i].classList.remove('is-shown');
        i = (i + 1) % phrases.length;
        phrases[i].classList.add('is-shown');
      }, 2400);
    }

    // DVD-screensaver bounce: each character of "Font.Garden" drifts
    // around the gradient panel and bounces off its edges.
    const panel = document.getElementById('field-panel');
    if (panel && !reduced.matches && panel.clientWidth > 120) {
      const spawn = (el) => {
        panel.appendChild(el);
        const speed = 30 + Math.random() * 50;
        const angle = Math.random() * Math.PI * 2;
        return {
          el,
          x: Math.random() * (panel.clientWidth - 40),
          y: Math.random() * (panel.clientHeight - 60),
          vx: Math.cos(angle) * speed,
          vy: Math.sin(angle) * speed,
        };
      };
      const chars = 'FontGarden'.split('').map((ch) => {
        const el = document.createElement('span');
        el.className = 'dvd-char';
        el.textContent = ch;
        return spawn(el);
      });
      const rose = document.createElement('img');
      rose.src = '/graphics/rose-001.png';
      rose.alt = '';
      rose.className = 'dvd-img';
      chars.push(spawn(rose));
      let last = performance.now();
      const step = (now) => {
        const dt = Math.min((now - last) / 1000, 0.05);
        last = now;
        const w = panel.clientWidth;
        const h = panel.clientHeight;
        for (const c of chars) {
          const cw = c.el.offsetWidth;
          const chh = c.el.offsetHeight;
          c.r = Math.max(cw, chh) / 2;
          c.x += c.vx * dt;
          c.y += c.vy * dt;
          if (c.x <= 0) { c.x = 0; c.vx = Math.abs(c.vx); }
          if (c.x >= w - cw) { c.x = w - cw; c.vx = -Math.abs(c.vx); }
          if (c.y <= 0) { c.y = 0; c.vy = Math.abs(c.vy); }
          if (c.y >= h - chh) { c.y = h - chh; c.vy = -Math.abs(c.vy); }
        }
        // Elastic collisions between letters (equal mass, circle bodies).
        for (let a = 0; a < chars.length; a++) {
          for (let b = a + 1; b < chars.length; b++) {
            const A = chars[a];
            const B = chars[b];
            const ax = A.x + A.r;
            const ay = A.y + A.r;
            const bx = B.x + B.r;
            const by = B.y + B.r;
            const dx = bx - ax;
            const dy = by - ay;
            const dist = Math.hypot(dx, dy) || 1;
            const minDist = (A.r + B.r) * 0.8;
            if (dist < minDist) {
              const nx = dx / dist;
              const ny = dy / dist;
              // Push the pair apart so they do not stick together.
              const overlap = (minDist - dist) / 2;
              A.x -= nx * overlap;
              A.y -= ny * overlap;
              B.x += nx * overlap;
              B.y += ny * overlap;
              // Swap the velocity components along the collision normal
              // if the letters are moving toward each other.
              const va = A.vx * nx + A.vy * ny;
              const vb = B.vx * nx + B.vy * ny;
              if (va - vb > 0) {
                A.vx += (vb - va) * nx;
                A.vy += (vb - va) * ny;
                B.vx += (va - vb) * nx;
                B.vy += (va - vb) * ny;
              }
            }
          }
        }
        for (const c of chars) {
          c.el.style.transform = `translate(${c.x}px, ${c.y}px)`;
        }
        requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    }
  </script>
</Layout>
