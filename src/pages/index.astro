---
import Layout from '../layouts/Layout.astro';
import FontFaces from '../components/FontFaces.astro';
import FontIndexList from '../components/FontIndexList.astro';
import FontIndexPanel from '../components/FontIndexPanel.astro';
import { loadFonts } from '../lib/fonts';
import '../styles/fonts.css';

const fonts = await loadFonts();
---

<Layout title="Font.Garden: fonts that are neural networks">
  <FontFaces fonts={fonts} index slot="head" />
  <FontIndexPanel />

  <main
    class="relative z-10 flex min-h-[100dvh] flex-col pl-[var(--margin)] pr-[calc(var(--field)+2*var(--margin))] pt-[calc(var(--margin)+var(--text-logo)*1.25)] pb-[var(--margin)]"
  >
    <!-- Intro -->
    <section class="max-w-[72ch]">
      <h1 class="sr-only">Font.Garden</h1>
      <p class="text-small text-ink">
        Font.Garden is a US-based AI lab rethinking typography for global
        scripts. We are developing NeuralType, a post-OpenType font format in
        which every font is a neural network. We train and release open-weight
        vector graphics models, with paid API access to our frontier models.
      </p>
    </section>

    <h2 class="font-index-title font-index-title-home">
      <a href="/fonts/" class="underline-offset-4 hover:underline">FTGD-100</a>
    </h2>
    <FontIndexList fonts={fonts} />

    <footer class="mt-auto pt-6">
      <nav class="flex items-center gap-5 text-small text-ink">
        <a href="/fonts/" class="underline-offset-4 hover:underline">Fonts</a>
        <a href="/docs/" class="underline-offset-4 hover:underline"
          >Documentation</a
        >
      </nav>
    </footer>
  </main>
</Layout>
