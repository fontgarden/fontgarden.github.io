{
  "name": "fontgarden-website",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@11.1.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check:html": "html-validate \"dist/**/*.html\"",
    "check": "astro build && python3 scripts/check_site.py && html-validate \"dist/**/*.html\"",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots"
  },
  "dependencies": {
    "astro": "^5.13.7"
  },
  "devDependencies": {
    "@astrojs/tailwind": "^5.1.3",
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.9.7",
    "html-validate": "^11.21.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  }
}
